# Normalize line endings
* text=auto

# Go source files — always LF
*.go text eol=lf

# Proto files — always LF
*.proto text eol=lf

# SQL — always LF
*.sql text eol=lf

# Shell / PowerShell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# YAML — always LF
*.yml text eol=lf
*.yaml text eol=lf

# Markdown — always LF
*.md text eol=lf

# Binaries
*.exe binary
*.dll binary
*.so binary
